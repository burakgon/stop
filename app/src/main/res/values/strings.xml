    <!-- Onboarding -->
    <string name="onboarding_welcome_title">Apps run only when you open them</string>
    <string name="onboarding_welcome_body">Stop closes the apps you choose as soon as you\'re done with them, and keeps them from waking up on their own.</string>
    <string name="onboarding_feature_sleep_title">Asleep until you open them</string>
    <string name="onboarding_feature_sleep_body">Blocked apps can\'t start themselves for alarms, background jobs or push messages.</string>
    <string name="onboarding_feature_leave_title">Closed when you leave</string>
    <string name="onboarding_feature_leave_body">After a short grace period, a blocked app is fully stopped, not just sent to the background.</string>
    <string name="onboarding_feature_updates_title">Updates keep working</string>
    <string name="onboarding_feature_updates_body">Nothing is disabled or hidden, so the Play Store keeps updating your apps.</string>
    <string name="onboarding_shizuku_title">Connect Shizuku</string>
    <string name="onboarding_shizuku_body">Android only lets the system stop other apps. Shizuku gives Stop that ability without rooting your phone.</string>
    <string name="onboarding_shizuku_ready">Shizuku is ready</string>
    <string name="onboarding_shizuku_uses">Stop uses it only to</string>
    <string name="onboarding_shizuku_use_running">See which apps are running</string>
    <string name="onboarding_shizuku_use_stop">Stop the apps you block</string>
    <string name="onboarding_shizuku_use_installs">Notice when you install an app</string>
    <string name="onboarding_notification_example_app">Charge Map</string>
    <string name="onboarding_notification_example_time">now</string>
    <string name="onboarding_shizuku_how">How do I start Shizuku?</string>
    <string name="onboarding_shizuku_steps">1. Open Shizuku and follow its steps for wireless debugging.\n2. Tap Start. Stop notices as soon as Shizuku runs.\n3. After every reboot, start Shizuku again. Blocked apps stay asleep until then.</string>
    <string name="onboarding_notifications_title">Get asked about new apps</string>
    <string name="onboarding_notifications_body">Whenever you install an app, Stop asks whether it may run in the background. This needs notifications.</string>
    <string name="onboarding_choose_title">Which apps may run in the background?</string>
    <string name="onboarding_choose_body">Pick the apps you rely on for messages, calls, music or navigation. Every other app is stopped when you leave it.</string>
